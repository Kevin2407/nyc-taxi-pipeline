    {
      "id": 9,
      "type": "barchart",
      "title": "(b) Ingreso promedio por viaje según la hora de subida",
      "description": "Ingreso total / viajes de cada hora (no promedio de promedios), desde modelo.agg_zone_hour. La tabla de al lado es preguntas.pregunta_b_hora_mayor_ingreso",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-taxi"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-taxi"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lpad(a.hora_subida::text, 2, '0') AS \"Hora\",\n  round((sum(a.ingreso_total) FILTER (WHERE d.anio_mes = '${mes}') / nullif(sum(a.viajes) FILTER (WHERE d.anio_mes = '${mes}'), 0))::numeric, 2) AS \"${mes}\",\n  round((sum(a.ingreso_total) FILTER (WHERE d.anio_mes = '${anterior}') / nullif(sum(a.viajes) FILTER (WHERE d.anio_mes = '${anterior}'), 0))::numeric, 2) AS \"${anterior}\"\nFROM modelo.agg_zone_hour a JOIN modelo.dim_date d ON a.fecha = d.fecha\nGROUP BY a.hora_subida ORDER BY a.hora_subida"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
