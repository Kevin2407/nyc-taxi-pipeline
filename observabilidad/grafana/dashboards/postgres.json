{
  "uid": "nyc-postgres",
  "title": "Postgres - base taxi",
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Postgres arriba (1 = sí)",
      "description": "El exporter logra conectarse a Postgres",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_up"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tamaño de la base taxi",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_database_size_bytes{datname=\"taxi\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cache hit ratio (5 min)",
      "description": "Porcentaje de bloques leídos desde la memoria (shared_buffers) en vez del disco. Más alto = mejor.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"taxi\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"taxi\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"taxi\"}[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Conexiones por estado",
      "description": "active = ejecutando una consulta ahora",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (pg_stat_activity_count)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Bloques leídos: memoria vs disco (por segundo)",
      "description": "Cada bloque son 8 kB. 'desde disco' alto = shared_buffers chico para esta carga",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_blks_hit{datname=\"taxi\"}[1m]))",
          "legendFormat": "{{datname}} desde caché"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_blks_read{datname=\"taxi\"}[1m]))",
          "legendFormat": "{{datname}} desde disco"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Archivos temporales escritos (bytes/s)",
      "description": "Ordenamientos/hash que no entraron en work_mem y se fueron a disco",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_temp_bytes{datname=\"taxi\"}[1m]))",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Filas leídas por segundo",
      "description": "'recorridas' = escaneos secuenciales; 'vía índice' = búsquedas por índice",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_tup_returned{datname=\"taxi\"}[1m]))",
          "legendFormat": "{{datname}} recorridas"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_tup_fetched{datname=\"taxi\"}[1m]))",
          "legendFormat": "{{datname}} vía índice"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Transacciones por segundo",
      "description": "Un timeout de una consulta cuenta como rollback",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{datname=\"taxi\"}[1m]))",
          "legendFormat": "{{datname}} commit"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{datname=\"taxi\"}[1m]))",
          "legendFormat": "{{datname}} rollback"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Filas escritas por segundo (insertadas, actualizadas, borradas)",
      "description": "'recorridas' = escaneos secuenciales; 'vía índice' = búsquedas por índice",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_tup_inserted{datname=\"taxi\"}[1m]))",
          "legendFormat": "insertadas",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_updated{datname=\"taxi\"}[1m]))",
          "legendFormat": "actualizadas",
          "refId": "B"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_deleted{datname=\"taxi\"}[1m]))",
          "legendFormat": "borradas",
          "refId": "C"
        }
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Logs de Postgres",
      "description": "Consultas de más de 1 s, conexiones y checkpoints (configurado en el docker-compose).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{servicio=\"postgres\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ],
  "tags": [
    "postgres"
  ]
}