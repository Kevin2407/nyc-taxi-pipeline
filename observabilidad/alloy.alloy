// Alloy: junta los logs de los contenedores de este proyecto y se los manda a Loki.
// Lee los contenedores a través del socket de Docker (montado en el compose).

// 1. Encontrar los contenedores del proyecto nyc-taxi.
discovery.docker "contenedores" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=nyc-taxi"]
  }
}

// 2. Ponerle a cada log la etiqueta "servicio" (postgres, pipeline, dagster-daemon...).
discovery.relabel "etiquetas" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "servicio"
  }
}

// 3. Leer los logs de esos contenedores.
loki.source.docker "logs" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.contenedores.targets
  relabel_rules = discovery.relabel.etiquetas.rules
  forward_to    = [loki.write.local.receiver]
}

// 4. Mandarlos a Loki.
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
