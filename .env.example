# Copiar a .env para cambiar algún valor. Sin .env se usan los valores por defecto.

# Mes asignado; el de comparación (mismo mes del año anterior) se calcula solo.
MES=2025-03

# Postgres
POSTGRES_USER=taxi
POSTGRES_PASSWORD=taxi
POSTGRES_DB=taxi
# Puerto en la máquina; cambiarlo si el 5432 ya está ocupado
POSTGRES_PORT=5432
